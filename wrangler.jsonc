{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assistente de IA do site ingrave.com.br. Nome novo para não colidir com o worker my-chat-agent antigo.
  "name": "ingrave-site-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // Domínio próprio: o DNS é criado no deploy (zona ingrave.com.br na mesma conta).
  "routes": [{ "pattern": "agente.ingrave.com.br", "custom_domain": true }],
  // Workers AI: modelo reserva quando o DGX Spark não responde (também passa pelo AI Gateway).
  "ai": { "binding": "AI", "remote": true },
  // AI Search (namespace "default"): busca híbrida com reranking no site ingrave.com.br.
  // A instância é escolhida em AI_SEARCH_INSTANCE; se não existir, a busca local (BM25) responde.
  "ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "default", "remote": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/chatwoot/*", "/health", "/voice", "/transcribe", "/feedback", "/video/*"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "IngraveAgent", "name": "IngraveAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["IngraveAgent"], "tag": "v1" }],
  // Limite por IP para abrir conversas (o limite por mensagem fica dentro de cada conversa).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4207", "simple": { "limit": 40, "period": 60 } },
    // Sessões de vídeo (cobradas por minuto): no máximo 2 por minuto por IP.
    { "name": "VIDEO_LIMITER", "namespace_id": "4208", "simple": { "limit": 2, "period": 60 } }
  ],
  "vars": {
    // AI Gateway + provedor customizado apontando para o DGX Spark (API compatível com OpenAI).
    "AI_GATEWAY_ACCOUNT_ID": "88903b729ba835b7dcc08993884c62c5",
    "AI_GATEWAY_ID": "default",
    "DGX_PROVIDER_SLUG": "dgx-spark",
    "DGX_MODEL": "gemma4:12b",
    "DGX_TIMEOUT_MS": "30000",
    "FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Instância do AI Search com o site rastreado (vazio desliga e usa só a busca local).
    "AI_SEARCH_INSTANCE": "assistente-ingrave",
    // Chatwoot (app.ingrave.com.br): caixa do tipo API dedicada ao assistente.
    "CHATWOOT_BASE_URL": "https://app.ingrave.com.br",
    "CHATWOOT_ACCOUNT_ID": "1",
    "CHATWOOT_INBOX_ID": "154",
    "CHATWOOT_HANDOFF_TEAM_ID": "",
    "MIRROR_CONVERSATIONS": "true",
    // Atendimento humano e agenda.
    "BUSINESS_HOURS": "1-5 09:00-18:00",
    // Minutos de expediente até alertar a equipe sobre lead ou transferência sem resposta (0 desliga).
    "FOLLOW_UP_MINUTES": "120",
    "TIMEZONE": "America/Sao_Paulo",
    "BOOKINGS_URL": "https://bookings.cloud.microsoft/book/Ingrave1@ingrave.com.br/",
    "SITE_ORIGINS": "https://ingrave.com.br,https://www.ingrave.com.br",
    // Voz (botão "Ouvir" nas respostas): ElevenLabs, ativo quando o secret ELEVENLABS_API_KEY existe.
    "ELEVENLABS_VOICE_ID": "EXAVITQu4vr4xnSDxMaL",
    "ELEVENLABS_MODEL_ID": "eleven_multilingual_v2",
    // Íris em vídeo (HeyGen LiveAvatar, modo LITE): ativo com o secret LIVEAVATAR_API_KEY e um avatar.
    // LIVEAVATAR_SANDBOX="true" testa sem gastar créditos (avatar de teste, sessões de ~1 minuto).
    "LIVEAVATAR_AVATAR_ID": "",
    "LIVEAVATAR_SANDBOX": "",
    "VIDEO_MAX_SECONDS": "300"
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): AI_GATEWAY_TOKEN, DGX_API_KEY (opcional), CHATWOOT_API_TOKEN,
  // CHATWOOT_WEBHOOK_SECRET, TEAMS_WEBHOOK_URL (opcional), ELEVENLABS_API_KEY (opcional, voz).
}
