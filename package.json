{
  "name": "ingrave-site-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Assistente de IA do site ingrave.com.br (Cloudflare Agents + AI Gateway/DGX Spark + Chatwoot)",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts --strict-vars=false",
    "sync-knowledge": "node scripts/sync-knowledge.mjs",
    "test": "vitest run",
    "check": "tsc && vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.84",
    "@ai-sdk/provider": "^3.0.14",
    "@cloudflare/ai-chat": "^0.9.3",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "livekit-client": "^2.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
