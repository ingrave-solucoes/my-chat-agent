{
  "extends": "agents/tsconfig",
  "compilerOptions": {
    // Runtime types come from `wrangler types` (env.d.ts), not the
    // @cloudflare/workers-types package.
    "types": ["node", "vite/client"]
  },
  // Independent Workers kept in this repository (payment workflow and container) have their own configs.
  "exclude": ["node_modules", "dist", "workflows", "container"]
}
